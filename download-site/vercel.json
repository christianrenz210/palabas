{
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p dist && cp index.html style.css script.js dist/ && curl -fsSL -o dist/palabas.apk https://github.com/christianrenz210/palabas/releases/latest/download/palabas.apk",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/palabas.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"palabas.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
